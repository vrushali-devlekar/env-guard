{
  "name": "env-guard",
  "version": "1.0.0",
  "description": "CLI tool to audit .env files, scan live secret leaks, sync variables interactively, and generate Zod schemas",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "env-guard": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "dotenv",
    "env-guard",
    "cli",
    "secret-scanner",
    "zod",
    "audit",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@inquirer/prompts": "^7.3.2",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "express": "^5.2.1",
    "open": "^11.0.1",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.4",
    "@types/open": "^6.1.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
